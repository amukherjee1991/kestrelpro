# Copy to .env and edit. Only ADMIN_PASSWORD is required.

# ---- Required -------------------------------------------------------------------------
# Password for the admin UI. KestrelPro's pages sign in with it too; the engine itself uses
# a local password that can manage block/allow lists but not change settings.
ADMIN_PASSWORD=

# ---- Basics ---------------------------------------------------------------------------
# Time zone for logs and charts, e.g. Europe/Berlin or America/New_York.
TZ=Etc/UTC
# Upstream DNS servers, separated by ";".
FTLCONF_dns_upstreams=1.1.1.1;9.9.9.9
# Answer DNS from any network that can reach this host (the default for containers).
FTLCONF_dns_listeningMode=all

# ---- Ports ----------------------------------------------------------------------------
# DNS is published on every address of this host; set one address to limit it.
# DNS_BIND_IP=192.0.2.10
ADMIN_PORT=8080
KESTREL_ENGINE_PORT=8090
# Behind a reverse proxy that routes /admin/api/kestrel/ to the engine (see README):
# KESTREL_ENGINE_URL=/admin/api/kestrel
# Other admin-UI origins allowed to call the engine (its own host is always allowed):
# KESTREL_UI_ORIGINS=https://dns.example.lan

# ---- Model server ---------------------------------------------------------------------
# Run the bundled Ollama. Remove "ollama" and set OLLAMA_URL to use one elsewhere.
COMPOSE_PROFILES=ollama
# OLLAMA_URL=http://gpu-box.lan:11434
MODEL=gemma4:12b

# ---- AI review ------------------------------------------------------------------------
# KESTREL_ENGINE=off runs DNS and the admin UI only.
KESTREL_ENGINE=on
# true: suggestions wait for your approval (recommended to start). false: block automatically.
DRY_RUN=true
# realtime: new domains judged within ~15 s. eco: one pass every INTERVAL_SECONDS (slow/CPU models).
CADENCE=realtime
INTERVAL_SECONDS=600
MIN_CONFIDENCE=0.85
BLOCK_CATEGORIES=ads,tracking,malicious
# Extra never-block domains, comma-separated (subdomains included).
# PROTECTED_DOMAINS=example.com,myservice.example.net

# ---- Optional -------------------------------------------------------------------------
# Address ranges of VPN clients (e.g. a WireGuard subnet), so History can tell them apart.
# VPN_SUBNETS=10.8.0.0/24
# Device names from your router (conditional forwarding): enabled,network,router,local domain
# FTLCONF_dns_revServers=true,192.168.0.0/24,192.168.0.1,lan
# Notifications (also configurable in AI settings): ntfy topic or webhook URL.
# NOTIFY_KIND=ntfy
# NOTIFY_URL=https://ntfy.sh/your-private-topic
