# Copy to .env and fill in.

# Start the bundled Ollama. Remove "ollama" and set OLLAMA_URL to use one elsewhere.
COMPOSE_PROFILES=ollama
# OLLAMA_URL=http://192.168.1.10:11434

# Where DNS is published.
LAN_DNS_IP=192.168.1.53
VPN_DNS_IP=10.8.0.1
ADMIN_PORT=8080
ENGINE_PORT=8090

# Admin password for the web UI. The engine does not use it: it signs in to the DNS
# server with the local CLI password, which can manage lists but not change settings.
FTLCONF_webserver_api_password=change-me
TZ=America/Chicago
FTLCONF_dns_listeningMode=all
FTLCONF_dns_upstreams=1.1.1.1;9.9.9.9
# FTLCONF_dns_revServers=true,192.168.1.0/24,192.168.1.1,home.local
# FTLCONF_dns_hosts=10.8.0.2 Laptop-VPN;10.8.0.3 Phone-VPN

# Engine. KESTREL_ENGINE=off runs DNS and the admin UI only.
KESTREL_ENGINE=on
# Start in review mode (true) or block automatically (false). Changeable later in Settings.
DRY_RUN=true
MODEL=gemma4:12b
# realtime: new domains are judged within ~15 s. eco: one pass every INTERVAL_SECONDS.
CADENCE=realtime
INTERVAL_SECONDS=600
MIN_CONFIDENCE=0.85
BLOCK_CATEGORIES=ads,tracking,malicious
# PROTECTED_DOMAINS=example.com,myservice.example.net
VPN_SUBNET=10.8.0.0/24
